<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp"
    android:background="@color/bg_color"
    android:layout_marginBottom="8dp">

    <TextView
        android:id="@+id/orderId"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Order ID: 12345"
        android:textSize="16sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/orderTotal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Total: $100.00"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/orderId"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/orderTimestamp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Date: 2023-10-01"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/orderTotal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/orderStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Status: Processing"
        android:textSize="14sp"
        android:textColor="@color/primary"
        app:layout_constraintTop_toBottomOf="@id/orderTimestamp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="4dp" />
    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/btnViewOrder"
        android:backgroundTint="@color/primary"
        android:text="View Order"
        app:layout_constraintTop_toBottomOf="@+id/orderTimestamp"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>